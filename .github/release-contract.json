{
  "schema_version": 2,
  "source_of_truth": "immutable repository identity refs plus trusted preparation provenance",
  "version_file": "VERSION",
  "numeric_baseline": "highest eligible final remote product tag vX.Y.Z",
  "eligible_final_tag_provenance": {
    "owner": "protected-release-automation",
    "object_type": "annotated-tag",
    "tagger": "github-actions[bot]"
  },
  "virtual_final_baseline": "0.0.0",
  "version_grammar": {
    "prod": "X.Y.Z",
    "beta": "X.Y.Z-beta.N",
    "rc": "X.Y.Z-rc.N",
    "dev": "X.Y.Z-dev.N",
    "local_development": "next final patch-dev.<short-sha>"
  },
  "label_groups": {
    "type": [
      "type:major",
      "type:minor",
      "type:patch",
      "type:docs",
      "type:skip"
    ],
    "channel": [
      "channel:prod",
      "channel:beta",
      "channel:rc",
      "channel:dev"
    ]
  },
  "legacy_migration_map": {
    "channel:stable": "channel:prod",
    "channel:canary": "channel:dev",
    "type:none": "type:skip"
  },
  "release_actions": {
    "product": "type:major|minor|patch plus exactly one channel",
    "skip": "type:docs or type:skip without channel"
  },
  "workflows": {
    "label_gate": "Release intent label gate",
    "preparation": "Prepare product version",
    "completion": "Release completion",
    "release": "Release Product",
    "failure_notification": "Notify failed release"
  },
  "preparation": {
    "modes": ["normal", "version-only-release-pr"],
    "write_api": "createCommitOnBranch",
    "expected_head_oid": true,
    "signature": "github-native-verified",
    "completion_requires_native_verification": true,
    "only_path": "VERSION",
    "no_gpg_secrets": true,
    "allocation": "final-tag-first",
    "reservation_before_version": true
  },
  "identity_refs": {
    "reservation": "refs/tags/release-reservation/v<version>",
    "decision": "refs/tags/release-decision/v<version>",
    "bound": "refs/tags/release-bound/v<version>/<merge-sha>",
    "consumed": "refs/tags/release-consumed/v<version>/<merge-sha>",
    "released": "refs/tags/release-released/v<version>/<reservation-id>",
    "write_policy": "append-only-create",
    "state_order": "decision-before-bound-or-released;bound-before-consumed;released-only-when-unbound",
    "receipt_validation": "independently-verify-reservation-provenance"
  },
  "recovery": {
    "same_sha_operation": "recover",
    "same_sha_identity": "bound merge SHA + VERSION + channel + matching reservation",
    "dispatch_requires_existing_bound": true,
    "version_only_release_pr": "new non-empty VERSION-only PR with new merge identity",
    "historical_backfill": false,
    "queue": false,
    "auto_scan_history": false,
    "auto_create_pr": false,
    "unresolved_identity": "no version, tag, or recovery instruction"
  },
  "release_sequence": {
    "source": "remote product tags and existing reservation/receipt refs",
    "final_baseline": "highest final vX.Y.Z only",
    "prerelease_ordinal": "max existing same-base channel ordinal plus one",
    "lower_candidate": "reject-before-build",
    "equal_candidate": "require tag target equals merge SHA",
    "successor_on_recovery": false
  },
  "release_states": {
    "missing": "build-and-create",
    "draft": "build-upload-and-publish",
    "published": "idempotent-success-without-build-or-overwrite"
  },
  "helper_bootstrap": {
    "resolver": "published-prerelease-release-plus-verified-build-manifest",
    "candidate_order": [
      "current-product-rc1",
      "locked-bootstrap-release",
      "published-prerelease-releases"
    ],
    "source_modes": ["reuse-approved-release", "one-time-bootstrap"],
    "bootstrap_requires": "workflow_dispatch recover with helper_mode=bootstrap and no approved helper Release",
    "bootstrap_preserves_identity": true,
    "reuse_policy": "byte-identical-no-rebuild-no-lipo-no-resign",
    "identity_fields": ["sha256", "artifact_sha256", "cdhash", "designated_requirement"],
    "invalid_candidate_policy": "fallback-to-next-candidate",
    "terminal_states_before_resolution": ["published-release", "consumed-receipt"],
    "immutable_source_artifact": {
      "name": "snapshot-helper-source",
      "resolve_job": "download-and-verify-dmg-manifest-checksums",
      "consumer_jobs": ["build-arm64", "build-x86_64", "assemble"],
      "release_redownload_after_resolve": false
    }
  },
  "merge_policy": {
    "normal_merge_only": true,
    "release_reads_committed_identity": true,
    "remote_rules_mutated_by_this_contract": true,
    "remote_mutation_stage": "PR-ready Step 5C only"
  },
  "forbidden_identity_stores": ["git-notes", "control-branch", "external-database", "object-storage", "new-service"]
}
